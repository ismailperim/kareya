# Kareya environment — copy to `.env.local` and fill in your own keys.
# Every value here is read server-side only. NEVER commit `.env.local`.
# The build runner (apps/runner) reads this same file as a fallback, so one
# file configures the whole stack in development.

# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres (serverless, HTTP driver).
# Neon Console > Connection Details > pooled connection string.
DATABASE_URL=

# ── Voice (meeting room) ────────────────────────────────────────────────────
# ElevenLabs Conversational AI. The browser never sees the API key — it only
# receives a short-lived per-session token minted by /api/meeting/*/voice.
# Create/update the agent with: npx vite-node scripts/setup-agent.ts
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ── Storage (published sites + customer source code) ───────────────────────
# Cloudflare R2 via the S3 API. Create an API token with Object Read & Write:
# CF dashboard > R2 > Manage R2 API Tokens. Published output lives under
# sites/<slug>/, the customer's source tree under sources/<slug>/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kareya-assets

# Public host serving the R2 bucket (custom domain mapped to the bucket).
# Used for preview redirects and source links.
# PREVIEW_BASE_URL=https://preview.kareya.app

# ── LLM providers (build-time content + design) ────────────────────────────
# Content polish tries Gemini first (free tier), then Anthropic — set either
# or both (both recommended: they form a runtime fallback chain). With no key
# the site is generated with deterministic copy straight from the brief.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=                # override the Gemini model (default: gemini-flash-latest)

# Design Pass (v2): Claude writes per-project Astro component code, gated by
# an astro build + content check with a deterministic-kit fallback.
# Requires ANTHROPIC_API_KEY. Set DESIGN_PASS=0 to disable.
# DESIGN_PASS=0
# DESIGN_PASS_MODEL=claude-sonnet-4-5

# ── Images (optional) ──────────────────────────────────────────────────────
# Pexels: free API key (https://www.pexels.com/api/), commercial use allowed,
# no attribution required. Gemini image generation requires billing; opt in
# with GEMINI_IMAGE_ENABLED=1.
PEXELS_API_KEY=
# GEMINI_IMAGE_ENABLED=
# GEMINI_IMAGE_MODEL=

# ── Ops panel access ───────────────────────────────────────────────────────
# HTTP Basic Auth password for /ops and /api/ops (any username). Fail-closed:
# in production, an unset password LOCKS the panel. Put Cloudflare Access in
# front as a second layer if you have it.
OPS_PASSWORD=

# ── Runner (apps/runner) ───────────────────────────────────────────────────
# RUNNER_ROLE scopes which queue jobs this process claims:
#   all (default) — everything in one process
#   writer        — write_code / revise_site / build_site (needs LLM keys)
#   builder       — build_publish only (needs only DATABASE_URL + R2)
# RUNNER_ROLE=all
# RUNNER_POLL_MS=5000
