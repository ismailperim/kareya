# Neon Postgres (dev) — connection string
# Server-only SECRET: never expose to the client, never commit.
# Neon Console > Connection Details > pooled connection string.
DATABASE_URL=

# ElevenLabs Conversational AI (voice agent) — server-only SECRETS.
# ELEVENLABS_API_KEY: never expose to the client, never commit. The client
# only receives a short-lived per-session token minted by /api/meeting/*/voice.
# ELEVENLABS_AGENT_ID: the configured Agent (Turkish voice + update_brief tool).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
